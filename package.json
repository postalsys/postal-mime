{
    "name": "postal-mime",
    "version": "3.0.1",
    "description": "Email parser for Node.js and browser environments",
    "type": "module",
    "main": "./dist/cjs/postal-mime.js",
    "module": "./dist/esm/postal-mime.js",
    "types": "./dist/cjs/postal-mime.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/postal-mime.js",
            "require": "./dist/cjs/postal-mime.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "CHANGELOG.md",
        "LICENSE.txt"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-concurrency=1 test/*-test.ts",
        "lint": "eslint . && npm run typecheck",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,cjs,mjs,ts,json}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,mjs,ts,json}\"",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install"
    },
    "engines": {
        "node": ">=20"
    },
    "keywords": [
        "mime",
        "email"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/postal-mime.git"
    },
    "bugs": {
        "url": "https://github.com/postalsys/postal-mime/issues"
    },
    "homepage": "https://postal-mime.postalsys.com",
    "author": "Andris Reinman",
    "license": "MIT-0",
    "devDependencies": {
        "@types/node": "26.1.2",
        "eslint": "10.8.0",
        "globals": "17.9.0",
        "iframe-resizer": "4.3.6",
        "prettier": "3.9.6",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1"
    }
}
